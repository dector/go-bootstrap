package components

import (
	"net/http"
	"sort"
)

type RequestData struct {
	Method     string
	Path       string
	Query      map[string][]string
	Headers    map[string][]string
	Cookies    []*http.Cookie
	RemoteAddr string
	UserAgent  string
}

templ RequestInfo(data RequestData) {
	<div class="font-mono bg-neutral-800 p-4 rounded-lg my-4 border border-neutral-700">
		<h2 class="mt-0 mb-4 text-neutral-100 text-xl font-semibold">Request Information</h2>
		
		<div class="mb-4 space-y-1">
			<div><span class="font-semibold text-neutral-300">Method:</span> <span class="text-blue-400">{ data.Method }</span></div>
			<div><span class="font-semibold text-neutral-300">Path:</span> <span class="text-blue-400">{ data.Path }</span></div>
			<div><span class="font-semibold text-neutral-300">Remote Address:</span> <span class="text-blue-400">{ data.RemoteAddr }</span></div>
			<div><span class="font-semibold text-neutral-300">User Agent:</span> <span class="text-blue-400">{ data.UserAgent }</span></div>
		</div>

		if len(data.Query) > 0 {
			<div class="mb-4">
				<div class="font-semibold text-neutral-300 mb-2">Query Parameters:</div>
				<ul class="ml-6 space-y-1">
					{{ queryKeys := make([]string, 0, len(data.Query)) }}
					{{ for key := range data.Query { queryKeys = append(queryKeys, key) } }}
					{{ sort.Strings(queryKeys) }}
					for _, key := range queryKeys {
						{{ values := data.Query[key] }}
						<li>
							<code class="bg-neutral-700 text-neutral-200 px-2 py-1 rounded text-sm">{ key }</code>: 
							for i, value := range values {
								if i > 0 {
									<span class="text-neutral-400">, </span>
								}
								<span class="text-green-400">{ value }</span>
							}
						</li>
					}
				</ul>
			</div>
		}

		if len(data.Headers) > 0 {
			<div class="mb-4">
				<div class="font-semibold text-neutral-300 mb-2">Headers:</div>
				<ul class="ml-6 space-y-1">
					{{ headerKeys := make([]string, 0, len(data.Headers)) }}
					{{ for key := range data.Headers { headerKeys = append(headerKeys, key) } }}
					{{ sort.Strings(headerKeys) }}
					for _, key := range headerKeys {
						{{ values := data.Headers[key] }}
						<li>
							<code class="bg-neutral-700 text-neutral-200 px-2 py-1 rounded text-sm">{ key }</code>: 
							for i, value := range values {
								if i > 0 {
									<span class="text-neutral-400">, </span>
								}
								<span class="text-green-400">{ value }</span>
							}
						</li>
					}
				</ul>
			</div>
		}

		if len(data.Cookies) > 0 {
			<div class="mb-4">
				<div class="font-semibold text-neutral-300 mb-2">Cookies:</div>
				<ul class="ml-6 space-y-1">
					{{ sortedCookies := make([]*http.Cookie, len(data.Cookies)) }}
					{{ copy(sortedCookies, data.Cookies) }}
					{{ sort.Slice(sortedCookies, func(i, j int) bool { return sortedCookies[i].Name < sortedCookies[j].Name }) }}
					for _, cookie := range sortedCookies {
						<li>
							<code class="bg-neutral-700 text-neutral-200 px-2 py-1 rounded text-sm">{ cookie.Name }</code>: 
							<span class="text-green-400">{ cookie.Value }</span>
							if cookie.Domain != "" {
								<span class="text-neutral-500"> (domain: { cookie.Domain })</span>
							}
						</li>
					}
				</ul>
			</div>
		}
	</div>
}