package pages

import "mymyapp/internal/ui/components"

templ RequestDebugPage(data components.RequestData) {
	@BaseLayout("Request Debug") {
		<div class="container mx-auto px-4 py-8">
			<h1 class="text-3xl font-bold text-neutral-100 mb-6">Request Debug Information</h1>
			<div class="mb-6">
				<button type="button" class="rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-500 cursor-pointer" data-on:click="@get('/server-time')">Get server time</button>
				@ServerTime("Not requested yet")
			</div>
			@components.RequestInfo(data)
		</div>
	}
}

templ ServerTime(value string) {
	<p id="server-time" class="mt-2 text-neutral-300" aria-live="polite">Server time: { value }</p>
}
